{
  "site": {
    "title": "leafpress",
    "description": "A fast, opinionated static site generator for digital gardens",
    "author": "Shivam Shekhar",
    "baseURL": "https://leafpress.in"
  },
  "features": {
    "graph": false,
    "search": true,
    "toc": true
  },
  "navigation": {
    "mode": "explicit",
    "items": [
      {
        "label": "Guide",
        "path": "/guide/"
      },
      {
        "label": "Features",
        "path": "/features/"
      },
      {
        "label": "Changelog",
        "path": "/changelog/"
      }
    ]
  },
  "build": {
    "outputDir": "_site",
    "port": 3000
  },
  "theme": {
    "accent": "#16a34a",
    "background": {
      "dark": "linear-gradient(135deg, #0a0a0a 0%, #14532d 100%)",
      "light": "linear-gradient(135deg, #ffffff 0%, #dcfce7 100%)"
    },
    "fontBody": "Geist",
    "fontHeading": "Sora",
    "fontMono": "JetBrains Mono",
    "remoteFonts": true,
    "navActiveStyle": "base",
    "navStyle": "base"
  }
}
